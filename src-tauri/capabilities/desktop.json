{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/Salutatorian/jwconverter" },
        { "url": "https://github.com/Salutatorian/jwconverter/*" },
        { "url": "https://ffmpeg.org/download.html*" },
        { "url": "https://www.gyan.dev/ffmpeg/builds/" },
        { "url": "https://www.gyan.dev/ffmpeg/builds/*" }
      ]
    }
  ]
}
