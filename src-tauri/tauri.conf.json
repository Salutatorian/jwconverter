{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JW Converter",
  "version": "0.5.2",
  "identifier": "com.jw.jwconverter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JW Converter",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost https://ipc.localhost https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "publisher": "JW",
    "copyright": "Copyright © JW",
    "category": "Utility",
    "shortDescription": "Local-first audio and image converter",
    "longDescription": "Convert audio and images locally with FFmpeg and ImageMagick. Supports batch conversion, folder import, quality presets, and safe overwrite policies.",
    "licenseFile": "windows/LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/README.txt",
      "../third_party/THIRD_PARTY_FFMPEG.txt",
      "../third_party/THIRD_PARTY_IMAGEMAGICK.txt",
      "resources/imagemagick/"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "JW Converter"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEMkE0MTc3QjgyNjE0QjMKUldTekZDYTRkMEVxdmY2ZFppTVd0YzBMblQzeWZMKzE0Mk81NDBxdnFXVjFPTmV3Tk1ZZEhsMHYK",
      "endpoints": [
        "https://github.com/Salutatorian/jwconverter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
