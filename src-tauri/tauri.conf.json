{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JW Converter",
  "version": "0.1.0",
  "identifier": "com.jw.jwconverter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JW Converter",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "JW",
    "copyright": "Copyright © JW",
    "category": "Utility",
    "shortDescription": "Local-first Windows audio converter",
    "longDescription": "Convert audio files locally with FFmpeg. Supports batch conversion, folder import, quality presets, and safe overwrite policies.",
    "licenseFile": "windows/LICENSE.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/README.txt"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "JW Converter"
      }
    }
  }
}
